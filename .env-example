# Copy this file as .env and fill in the actual values (the .env file is ignored by Git, so do not commit it)
# cp .env-example .env

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-pro

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ---- Manager RAP 可选检索源（与 config.py 中 RAP_*_ENABLED 对应）----
# 不设则沿用 config 默认值。需要某一路时改为 true。
RAP_WEB=false
RAP_PWC=false
RAP_KAGGLE=false
# RAP_WEB_MAX_RESULTS=5
# RAP_FUSE_MAX_CHARS=3500

STUB_MODE=false
