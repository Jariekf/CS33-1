# Copy this file as .env and fill in the actual values (the .env file is ignored by Git, so do not commit it)
# cp .env-example .env

# --- RAG config ---
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_FETCH_K=10
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_ENABLE_RERANKER=true
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# RAG embedding provider (OpenAI-compatible).
# These take precedence over OPENAI_API_KEY / OPENAI_BASE_URL below, so the RAG
# embedding service can be configured independently of the main LLM routing.
# If unset, RAG falls back to OPENAI_API_KEY / OPENAI_BASE_URL.
# Example values for common providers (uncomment ONE block):
#   # OpenAI official
#   RAG_EMBEDDING_API_KEY=sk-xxx
#   RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
#   RAG_EMBEDDING_MODEL=text-embedding-3-small
#   RAG_EMBEDDING_BATCH_SIZE=2048
#   # Aliyun DashScope (Qwen) - OpenAI compatible mode (max batch=10)
#   RAG_EMBEDDING_API_KEY=sk-xxx
#   RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   RAG_EMBEDDING_MODEL=text-embedding-v3
#   RAG_EMBEDDING_BATCH_SIZE=10
#   # Zhipu (智谱) (max batch=64)
#   RAG_EMBEDDING_API_KEY=xxx.xxx
#   RAG_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   RAG_EMBEDDING_MODEL=embedding-3
#   RAG_EMBEDDING_BATCH_SIZE=64

# --- Chroma config ---
RAG_CHROMA_DIR=./workspace/chroma_rag
RAG_CHROMA_COLLECTION=rag_collection

# --- LLM config ---

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-pro

GEMINI_FLASH_API_KEY=
GEMINI_FLASH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_FLASH_MODEL=gemini-2.5-flash

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ---- Kaggle（RAP_KAGGLE=true 时需认证；kaggle>=2 读环境变量优先）----
# KAGGLE_API_TOKEN=

# ---- Optional: manager agent sub-stage model routing ----
# Valid values are profile names from core/llm.py, e.g.:
# deepseek / openai / qwen / kimi / gemini / zhipu / minimax
# If omitted, the code falls back to AGENT_PROFILE_MAP defaults.
# MANAGER_SUMMARY_PROFILE=openai
# MANAGER_FUSION_PROFILE=kimi
# MANAGER_PLAN_PROFILE=qwen

# ---- Manager RAP 可选检索源（与 config.py 中 RAP_*_ENABLED 对应）----
# 不设则沿用 config 默认值。需要某一路时改为 true。
RAP_WEB=false
RAP_PWC=false
RAP_KAGGLE=false
# RAP_WEB_MAX_RESULTS=5
# RAP_FUSE_MAX_CHARS=3500

STUB_MODE=false
