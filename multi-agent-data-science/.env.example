# Default LLM for the entire pipeline: deepseek | gemini_flash | gemini | openai | zhipu | qwen | minimax | kimi (flash → gemini_flash)
#PIPELINE_LLM=deepseek

# (Optional) Override PIPELINE_LLM individually per agent using the variable name PIPELINE_LLM_<suffix> (suffix in all caps, consistent with the internal format of llm_for)
PIPELINE_LLM_AGENT_MANAGER=gemini_flash
PIPELINE_LLM_DATA_CLEAN=gemini_flash
PIPELINE_LLM_SPLIT=gemini_flash
PIPELINE_LLM_EDA=gemini_flash
PIPELINE_LLM_FEATURE=gemini_flash
PIPELINE_LLM_MODEL=gemini_flash
PIPELINE_LLM_BAT=gemini_flash

# Example: layered strategy (light tasks → mini, core reasoning → strong)
# PIPELINE_LLM_AGENT_MANAGER=openai
# PIPELINE_LLM_DATA_CLEAN=openai
# PIPELINE_LLM_EDA=openai
# PIPELINE_LLM_FEATURE=openai_strong
# PIPELINE_LLM_MODEL=openai_strong
# PIPELINE_LLM_BAT=openai

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus

MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional: stronger model for core reasoning agents (e.g. gpt-4o).
# Used when PIPELINE_LLM_<AGENT>=openai_strong is set.
OPENAI_STRONG_MODEL=gpt-4o

GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-pro

GEMINI_FLASH_API_KEY=your_gemini_flash_api_key
GEMINI_FLASH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_FLASH_MODEL=gemini-2.5-flash

KIMI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

TRACE_TOOLS=true

# ── RAG / BAT (McKinsey KB + embeddings) ────────────────────
RAG_CHROMA_DIR=./artifacts/chroma_rag
RAG_CHROMA_COLLECTION=rag_collection
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_API_KEY=sk-5dd7cd1af9d845368320998388c08401
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_BATCH_SIZE=10
RAG_TOP_K=4
RAG_FETCH_K=10
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_MD_CHUNK_SIZE=1200
RAG_MD_CHUNK_OVERLAP=200
RAG_ENABLE_RERANKER=true
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# RAG Self-Rescue Retry and arXiv Fallback
RAG_RETRY_COUNT=2
RAG_FALLBACK_TO_ARXIV=true

MCKINSEY_COLLECTION=mckinsey_kb
MCKINSEY_PER_BUCKET_TOP_K=3
MCKINSEY_MIN_HITS=4
# Maximum number of tool recursions allowed within a BAT subgraph (LLM → Tools → Update);
# if this limit is exceeded, a report is generated to prevent a GraphRecursionError
BAT_MAX_TOOL_ROUNDS=15
ARXIV_MAX_RESULTS=5
STUB_MODE=false

# ── Manager RAP ────────────────
# Enable web retrieval via DuckDuckGo (requires: pip install duckduckgo-search).
RAP_WEB_ENABLED=true
WEB_MAX_RESULTS=5
RAP_ARXIV_MAX_RESULTS=2
RAP_FUSE_MAX_CHARS=3000

# ARXIV_INTER_QUERY_SLEEP=1.5
# ARXIV_RETRY_SLEEP=3.0