# 全流程默认 LLM：deepseek | gemini_flash | gemini | openai | zhipu | qwen | minimax | kimi（flash→gemini_flash）
#PIPELINE_LLM=deepseek

#（可选）按 agent 单独覆盖 PIPELINE_LLM，变量名为 PIPELINE_LLM_<后缀>（后缀全大写，与 llm_for 内部一致）
PIPELINE_LLM_AGENT_MANAGER=gemini_flash
PIPELINE_LLM_DATA_CLEAN=gemini_flash
PIPELINE_LLM_SPLIT=gemini_flash
PIPELINE_LLM_EDA=gemini_flash
PIPELINE_LLM_FEATURE=gemini_flash
PIPELINE_LLM_MODEL=gemini_flash
PIPELINE_LLM_BAT=gemini_flash

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus

MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-pro

GEMINI_FLASH_API_KEY=your_gemini_flash_api_key
GEMINI_FLASH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_FLASH_MODEL=gemini-2.5-flash

KIMI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

TRACE_TOOLS=true

# ── RAG / BAT (McKinsey KB + embeddings) ────────────────────
RAG_CHROMA_DIR=./artifacts/chroma_rag
RAG_CHROMA_COLLECTION=rag_collection
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_BATCH_SIZE=10
RAG_TOP_K=4
RAG_FETCH_K=10
RAG_ENABLE_RERANKER=true

MCKINSEY_COLLECTION=mckinsey_kb
MCKINSEY_PER_BUCKET_TOP_K=3
MCKINSEY_MIN_HITS=4
# BAT 子图内最多允许的工具循环次数（LLM→Tools→更新），超限则强制生成报告，避免 GraphRecursionError
BAT_MAX_TOOL_ROUNDS=15
ARXIV_MAX_RESULTS=5
STUB_MODE=false

# ── Manager RAP──
# 打开后需 pip install duckduckgo-search (requirements.txt)已更新；默认 false 时 web_raw_chars 恒为 0。
RAP_WEB_ENABLED=false
# DuckDuckGo 文本结果条数上限（读环境变量 WEB_MAX_RESULTS，非 RAP_WEB_MAX_RESULTS）
WEB_MAX_RESULTS=3
# 送入融合 LLM 前对检索正文的最大截断长度
RAP_FUSE_MAX_CHARS=6000
# 写入 agent_manager_report.md 内 RAP 中层节预览长度
MANAGER_RAP_REPORT_SUMMARY_CHARS=800
MANAGER_RAP_REPORT_CONTEXT_CHARS=1200